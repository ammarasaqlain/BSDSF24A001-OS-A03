#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include "shell.h"

// this function checks if the command is a built-in and runs it if it is.
// it returns 1 if it handled the command, and 0 if it was not a built-in.
int handle_builtin(char** arglist) {
    if (arglist == NULL || arglist[0] == NULL) {
        return 0; 
    }

    if (strcmp(arglist[0], "exit") == 0) {
        exit(0); // terminates the shell gracefully
    } 
    else if (strcmp(arglist[0], "cd") == 0) {
        if (arglist[1] == NULL) {
            printf("myshell: expected argument to \"cd\"\n");
        } else {
            if (chdir(arglist[1]) != 0) {
                perror("myshell"); // error if directory doesn't exist
            }
        }
        return 1; 
    } 
    else if (strcmp(arglist[0], "help") == 0) {
        printf("myshell built-in commands:\n");
        printf("  cd <dir>  : change working directory\n");
        printf("  help      : show this message\n");
        printf("  jobs      : list background jobs\n");
        printf("  exit      : terminate the shell\n");
        return 1; 
    } 
    else if (strcmp(arglist[0], "jobs") == 0) {
        printf("Job control not yet implemented.\n");
        return 1; 
    }

    return 0; // it is NOT a built-in command
}

int main() {
    char* cmdline;
    char** arglist;
    char* prompt = "FCIT> ";

    while (1) {
        // read the user input using your new readline setup
        cmdline = read_cmd(prompt, stdin);
        
        // handle ctrl+d (EOF) to exit safely
        if (cmdline == NULL) {
            printf("\n");
            exit(0);
        }

        // chop the input string into an array of arguments
        arglist = tokenize(cmdline);

        if (arglist != NULL && arglist[0] != NULL) {
            
            // CRITICAL STEP: check if the command is a built-in FIRST
            if (handle_builtin(arglist) == 0) {
                
                // if handle_builtin returned 0, it means it was an external command.
                // only THEN do we safely pass it to the fork-exec cycle.
                execute(arglist); 
            }
        }

        // free the memory allocated by readline so you don't leak memory
        if (cmdline != NULL) {
            free(cmdline);
        }
    }
    
    return 0;
}
